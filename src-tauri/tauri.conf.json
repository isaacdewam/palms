{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palms",
  "version": "0.1.0",
  "identifier": "com.palms.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palms",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNENDQjIzRkVFRjE4MDIKUldRQ0dPLytJOHRNRTZsbXJiQzMvQkJya1NUa2k5WXdBV3Y0dWsyV3BMbjdzdldqMXlMbU8zdSsK",
      "endpoints": [
        "https://github.com/isaacdewam/longus/releases/latest/download/latest.json"
      ]
    }
  }
}
